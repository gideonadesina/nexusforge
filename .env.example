# NexusForge environment configuration.
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# FalkorDB connection (required)
FALKORDB_HOST=
FALKORDB_PORT=
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
# "true" to connect over TLS (rediss://). FalkorDB Cloud free tier does not
# currently offer TLS; set to "false" there.
FALKORDB_TLS=false

# Graph name used by the application. Must start with the "nf_" prefix so this
# project can never touch a graph it does not own.
FALKORDB_GRAPH=nf_demo_education
